<Window x:Class="GarlicSaveMgr.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar operación" FontFamily="Segoe UI" FontSize="{DynamicResource Theme.FontSize}"
        Width="{DynamicResource Theme.DialogWidth}"
        Height="400"
        MinWidth="{DynamicResource Theme.DialogWidth}"
        MinHeight="400"
        MaxWidth="{DynamicResource Theme.DialogWidth}"
        MaxHeight="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource AppBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" Grid.Row="0" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondary}" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" />

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.ComboBoxItemCornerRadius}" Padding="2">
            <ListBox x:Name="ItemsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,5" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="✓" Foreground="{DynamicResource Success}" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Primary}" FontSize="{DynamicResource Theme.FontSize}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Secondary}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Secondary}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="CountText" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Width="100" Margin="6,0,0,0" IsCancel="True" Click="Cancel_Click">Cancelar</Button>
                <Button x:Name="ConfirmButton" Width="146" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Confirm_Click" Content="Continuar" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
