<Window x:Class="GarlicSaveMgr.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes - Garlic SaveMgr"
        Width="{DynamicResource Theme.SettingsWidth}"
        MinWidth="{DynamicResource Theme.SettingsMinWidth}"
        MinHeight="{DynamicResource Theme.SettingsMinHeight}"
        SizeToContent="Height"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="{DynamicResource AppBackground}"
        FontFamily="{DynamicResource Theme.FontFamily}" FontSize="{DynamicResource Theme.FontSize}" Loaded="SettingsWindow_Loaded">
    <Grid Margin="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.CardCornerRadius}" Padding="18,14">
                    <StackPanel><TextBlock Text="Configuración de consola" FontSize="{DynamicResource Theme.TitleFontSize}" FontWeight="{DynamicResource Theme.EmphasisFontWeight}" /><TextBlock Text="Configura la consola Garlic y comprueba la conexión." Margin="0,3,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" /></StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.CardCornerRadius}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Label Grid.Row="0" Grid.Column="0">Nombre</Label><TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" />
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">IP</Label><TextBox Grid.Row="1" Grid.Column="1" x:Name="IpBox" Margin="0,10,0,0" />
                        <Label Grid.Row="2" Grid.Column="0" Margin="0,10,0,0">Puerto</Label><TextBox Grid.Row="2" Grid.Column="1" x:Name="PortBox" Text="8082" Margin="0,10,0,0" />
                        <Button Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" Click="Ping_Click">Verificar conexión</Button>
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.CardCornerRadius}" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Apariencia y temas" FontSize="{DynamicResource Theme.SectionFontSize}" FontWeight="{DynamicResource Theme.EmphasisFontWeight}" />
                        <Label Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">Tema XML</Label>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ThemeBox" Margin="0,12,0,0">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Label Grid.Row="2" Grid.Column="0" Margin="0,10,12,0">Modo</Label>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                            <TextBlock Text="Claro" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                            <ToggleButton x:Name="ThemeModeSwitch" Style="{StaticResource ThemeSwitch}" ToolTip="Cambiar entre modo claro y oscuro" Checked="ThemeModeSwitch_Checked" Unchecked="ThemeModeSwitch_Unchecked" />
                            <TextBlock Text="Oscuro" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0" Background="{DynamicResource SurfaceAlt}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.CardCornerRadius}" Padding="{DynamicResource Theme.CardPadding}">
                    <StackPanel><TextBlock Text="Aplicación portable" FontWeight="{DynamicResource Theme.EmphasisFontWeight}" /><TextBlock TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource TextSecondary}" Text="Los datos, copias, carátulas, logs, caché del payload y temas personalizados se guardan en la carpeta de la aplicación (junto al ejecutable). La carpeta debe ser escribible." /><TextBlock TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondary}" Text="Para aplicar los cambios pulsa Aceptar. El tema estándar interno se utiliza automáticamente si no hay otro tema configurado o si uno externo no es válido." /></StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Width="96" Click="Cancel_Click">Cancelar</Button><Button Width="104" Style="{StaticResource PrimaryButton}" Click="Ok_Click">Aceptar</Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
