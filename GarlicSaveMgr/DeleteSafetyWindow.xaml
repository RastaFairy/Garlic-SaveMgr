<Window x:Class="GarlicSaveMgr.DeleteSafetyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protección de eliminación" FontFamily="Segoe UI" FontSize="{DynamicResource Theme.FontSize}"
        Width="{DynamicResource Theme.DialogWidth}"
        Height="420"
        MinWidth="{DynamicResource Theme.DialogWidth}"
        MinHeight="420"
        MaxWidth="{DynamicResource Theme.DialogWidth}"
        MaxHeight="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource AppBackground}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" Grid.Row="0" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,5" />
        <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextSecondary}" Grid.Row="1" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" CornerRadius="{DynamicResource Theme.ComboBoxItemCornerRadius}" Padding="2">
            <ListBox x:Name="ItemsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,5" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="⚠" Foreground="{DynamicResource Warning}" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Primary}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Secondary}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Width="100" Margin="6,0,0,0" IsCancel="True" Click="Cancel_Click">Cancelar</Button>
            <Button Width="160" Margin="6,0,0,0" Style="{StaticResource DangerButton}" Click="Permanent_Click" ToolTip="Eliminar las copias de forma definitiva"><TextBlock x:Name="PermanentButtonText" Text="Eliminar definitivamente" TextWrapping="NoWrap" TextAlignment="Center" /></Button>
            <Button x:Name="InternalButton" Width="205" Margin="6,0,0,0" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="InternalBackup_Click" ToolTip="Retirar conservando la copia en la Papelera PC"><StackPanel HorizontalAlignment="Center"><TextBlock x:Name="InternalButtonText" Text="Respaldar y eliminar" TextWrapping="NoWrap" TextAlignment="Center" HorizontalAlignment="Center" /><TextBlock x:Name="InternalBackupDescription" Text="" FontSize="10" Foreground="{DynamicResource OnAccentMuted}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" MaxWidth="190" /></StackPanel></Button>
        </StackPanel>
    </Grid>
</Window>
