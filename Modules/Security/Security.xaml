<UserControl x:Class="GarlicSaveMgr.Modules.Security.SecurityView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Tag="security"
            FontFamily="Segoe UI"
            Background="Transparent">

                        <Grid Margin="4,10,4,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="Integridad de copias" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="SecuritySummaryLabel" DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" />
                            </DockPanel>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button x:Name="VerifyAllSecurityButton" Width="150" Click="VerifyAllSecurity_Click">Verificar todas</Button>
                                <Button x:Name="VerifySelectedSecurityButton" Width="170" Click="VerifySelectedSecurity_Click"><TextBlock Text="Verificar seleccionadas" TextWrapping="NoWrap" TextAlignment="Center" /></Button>
                                <TextBlock Text="Las copias sin SHA-256 o con hash distinto quedan bloqueadas para restauración." VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="12,0,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <DataGrid x:Name="SecurityGrid" Grid.Row="2" Style="{DynamicResource DataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="✓" Width="45" Binding="{Binding Selected}" />
                                    <DataGridTextColumn Header="Title ID" Width="115" Binding="{Binding TitleId}" />
                                    <DataGridTextColumn Header="Slot" Width="200" Binding="{Binding SaveName}" />
                                    <DataGridTextColumn Header="Tamaño" Width="85" Binding="{Binding SizeDisplay}" />
                                    <DataGridTextColumn Header="Integridad" Width="105" Binding="{Binding IntegrityStatus}" />
                                    <DataGridTextColumn Header="SHA-256" Width="*" Binding="{Binding Sha256}" />
                                    <DataGridTextColumn Header="Fecha" Width="150" Binding="{Binding Date}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    
</UserControl>
