<UserControl x:Class="GarlicSaveMgr.Modules.Salud.SaludView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Background="Transparent"
             Tag="salud">
    <Grid Margin="4,10,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="SALUD 2.2 · Observabilidad" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                <TextBlock x:Name="SaludActiveLabel" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SaludUserCountLabel" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Width="130" Click="RefreshSalud_Click">Actualizar</Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{DynamicResource CardBorder}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Width="130">
                    <TextBlock Text="SALUD" Style="{DynamicResource SectionLabel}"/>
                    <TextBlock x:Name="SaludHealthScore" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="SaludHealthLabel" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Width="220" Margin="16,0,20,0">
                    <TextBlock Text="ESTADO" Style="{DynamicResource SectionLabel}"/>
                    <TextBlock x:Name="SaludHealthFactors" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="RESUMEN" Style="{DynamicResource SectionLabel}"/>
                    <TextBlock x:Name="SaludSessionSummary" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    <TextBlock x:Name="SaludStorageTrend" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    <TextBlock x:Name="SaludApplicationSummary" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                    <TextBlock x:Name="SaludCoverSummary" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{DynamicResource CardBorder}" Padding="10" Margin="0,0,5,0">
                <StackPanel><TextBlock Text="PS5" Style="{DynamicResource SectionLabel}"/><TextBlock x:Name="SaludPs5Summary" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/><TextBlock x:Name="SaludPs5Detail" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{DynamicResource CardBorder}" Padding="10" Margin="5,0">
                <StackPanel><TextBlock Text="BACKUPS" Style="{DynamicResource SectionLabel}"/><TextBlock x:Name="SaludPcSummary" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/><TextBlock x:Name="SaludPcDetail" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{DynamicResource CardBorder}" Padding="10" Margin="5,0">
                <StackPanel><TextBlock Text="SNAPSHOTS" Style="{DynamicResource SectionLabel}"/><TextBlock x:Name="SaludSnapshotSummary" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/><TextBlock x:Name="SaludSnapshotDetail" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{DynamicResource CardBorder}" Padding="10" Margin="5,0,0,0">
                <StackPanel><TextBlock Text="INTEGRIDAD" Style="{DynamicResource SectionLabel}"/><TextBlock x:Name="SaludIntegritySummary" FontWeight="SemiBold" FontSize="14" Margin="0,3,0,0"/><TextBlock x:Name="SaludSmartSummary" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/></StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.8*"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,6,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="ANOMALÍAS DETECTADAS" Style="{DynamicResource SectionLabel}" Margin="4,0,0,6"/>
                <DataGrid x:Name="SaludAnomaliesGrid" Grid.Row="1" Style="{DynamicResource DataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0" Margin="0,0,0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severidad" Width="95" Binding="{Binding Severity}"/>
                        <DataGridTextColumn Header="Problema" Width="180" Binding="{Binding Title}"/>
                        <DataGridTextColumn Header="Descripción" Width="*" Binding="{Binding Description}"/>
                        <DataGridTextColumn Header="Recomendación" Width="2*" Binding="{Binding Recommendation}"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="HISTÓRICO DE SNAPSHOTS" Style="{DynamicResource SectionLabel}" Margin="4,0,0,6"/>
                    <DataGrid x:Name="SaludSnapshotsGrid" Grid.Row="1" Style="{DynamicResource DataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha" Width="140" Binding="{Binding CreatedLocal, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}"/>
                            <DataGridTextColumn Header="Juego" Width="*" Binding="{Binding TitleName}"/>
                            <DataGridTextColumn Header="Slot" Width="160" Binding="{Binding SaveName}"/>
                            <DataGridTextColumn Header="Tamaño" Width="95" Binding="{Binding SizeDisplay}"/>
                            <DataGridTextColumn Header="Estado" Width="120" Binding="{Binding State}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <Grid Grid.Column="1" Margin="6,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="RECOMENDACIONES" Style="{DynamicResource SectionLabel}" Margin="4,0,0,6"/>
                <ListBox Grid.Row="1" x:Name="SaludRecommendationsList" BorderThickness="0" Background="Transparent" MaxHeight="170">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource CardBorder}" Padding="8" Margin="0,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Text="CONEXIONES" Style="{DynamicResource SectionLabel}" Margin="4,8,0,6"/>
                <DataGrid Grid.Row="3" x:Name="SaludConnectionsList" Style="{DynamicResource DataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="IP" Width="125" Binding="{Binding Ip}"/>
                        <DataGridTextColumn Header="Garlic" Width="75" Binding="{Binding Garlic}"/>
                        <DataGridTextColumn Header="elfldr" Width="75" Binding="{Binding ElfLdr}"/>
                        <DataGridTextColumn Header="Estado" Width="90" Binding="{Binding State}"/>
                        <DataGridTextColumn Header="user_id" Width="*" Binding="{Binding UserIds}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
